{
  "name": "@ai-crew-suite/action-sync-eslint-config",
  "description": "GitHub Action to sync ESLint configuration",
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "keywords": [],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.1",
  "private": true,
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "actions/sync-eslint-config"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license third-party-licenses.txt",
    "clean": "crew clean",
    "format": "crew format",
    "lint": "yarn lint:actions && yarn lint:typescript",
    "lint:actions": "FORCE_COLOR=1 npx node-actionlint",
    "lint:typescript": "yarn build && crew lint",
    "test": "yarn test:unit",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit --coverage",
    "typecheck": "yarn build && crew typecheck",
    "typecheck:full": "yarn build && crew typecheck --force"
  },
  "dependencies": {
    "@actions/core": "catalog:prod",
    "@actions/github": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "catalog:dev",
    "@ai-crew-suite/typescript-shared-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vercel/ncc": "catalog:dev",
    "eslint": "catalog:dev",
    "node-actionlint": "catalog:dev",
    "prettier": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
