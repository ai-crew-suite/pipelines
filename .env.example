# ──────────────────────────────────────────────────────────────────────────────
# 🧰 AI CREW SUITE: UNIFIED RUNTIME ENVIRONMENT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to '.env' in your repository root to configure local execution.
# Variables listed here must be declared in 'turbo.json' under global or task env
# arrays to ensure Turborepo does not experience broken cache-invalidation loops.

# ──────────────────────────────────────────────────────────────────────────────
# 🚀 SYSTEM DEFAULTS & GLOBAL FLAGS
# ──────────────────────────────────────────────────────────────────────────────

# NODE_ENV: Dictates runtime optimization loops ('development', 'production', 'test')
NODE_ENV=development

# CI: Forces continuous integration rules (strict warnings, parallel worker throttles)
CI=false

# 📢 DEPLOYMENT WORKFLOW NOTIFICATIONS (CI/CD INTEGRATIONS)
# ──────────────────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL: Webhook URL used by your master publishing runners to broadcast
# build successes, delivery statuses, or compiler crash alerts.
SLACK_WEBHOOK_URL=https://slack.com
